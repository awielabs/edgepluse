# EduPulse Environment Configuration

# Server Port
PORT=5000

# JSON Web Token Secret
JWT_SECRET=edupulse-super-secret-jwt-key-change-in-production

# MongoDB Atlas Connection String
# Replace with your actual MongoDB Atlas connection credentials:
# Format: mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/edupulse?retryWrites=true&w=majority
MONGODB_URI=

# Optional local database file path (used if MONGODB_URI is not provided)
DB_FILE=edupulse.db
